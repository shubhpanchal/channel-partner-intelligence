# ==============================================================================
# Channel Partner Intelligence - Environment Configuration Template
# Copy this file to `.env` (or `backend/.env` and `frontend/.env.local`)
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Backend Configuration
PROJECT_NAME="Channel Partner Intelligence"
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Database Configuration (SQLite for local development)
DATABASE_URL=sqlite:///./channel_partner_intelligence.db

# CORS Allowed Origins (Comma-separated list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="Channel Partner Intelligence"
